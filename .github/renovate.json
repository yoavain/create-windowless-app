{
    "extends": ["config:base"],
    "labels": ["renovate", "dependencies"],
    "packageRules": [
        {
            "depTypeList": ["dependencies"],
            "labels": ["dependencies"],
            "updateTypes": ["minor", "patch"],
            "automerge": true
        },
        {
            "depTypeList": ["devDependencies"],
            "labels": ["dev-dependencies"],
            "updateTypes": ["minor", "patch"],
            "automerge": true
        }
    ],
    "prConcurrentLimit": 5,
    "minimumReleaseAge": "14 days",
    "internalChecksFilter": "strict",
    "ignoreNpmrcFile": true
}
