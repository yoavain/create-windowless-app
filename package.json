{
    "name": "create-windowless-app",
    "version": "14.0.0",
    "description": "Create a windowless NodeJS app",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": {
        "create-windowless-app": "./dist/index.js"
    },
    "scripts": {
        "prepare": "npm run husky-install && npx fix-lockfile-integrity",
        "husky-install": "git config --get core.hookspath || husky",
        "prebuild": "npm run test",
        "build": "npm run build:no-test",
        "build:no-test": "npm run tsc && npm run add-shebang && npm run package",
        "build:no-test:ci": "npm run tsc && npm run add-shebang && del package-lock.json && npm prune --omit=dev && npm shrinkwrap && npm run package",
        "test": "npm run eslint && npm run type-check && npm run jest",
        "eslint": "eslint src/ test/ integration_test/ templates/ scripts/ *.ts",
        "eslint:fix": "npm run eslint -- --fix",
        "type-check": "tsc --build tsconfig.json",
        "jest": "cross-env FORCE_COLOR=0 jest",
        "jest:unit": "cross-env FORCE_COLOR=0 jest ./test/",
        "jest:integration": "cross-env FORCE_COLOR=0 jest ./integration_test/",
        "prettier": "prettier --write *.json templates/**/*.json",
        "pretsc": "rimraf dist",
        "tsc": "tsc --build tsconfig.build.json",
        "add-shebang": "node -r ts-node/register/transpile-only scripts/add-shebang.ts",
        "start": "ts-node src/index.ts",
        "start:help": "npm run start -- --help",
        "package": "npm pack",
        "pre-commit": "lint-staged"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yoavain/create-windowless-app.git"
    },
    "keywords": [
        "windowless",
        "no console",
        "nodew",
        "template",
        "typescript"
    ],
    "author": "yoavain",
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
        "npm": ">=9"
    },
    "files": [
        "dist/**",
        "templates/**"
    ],
    "bugs": {
        "url": "https://github.com/yoavain/create-windowless-app/issues"
    },
    "homepage": "https://github.com/yoavain/create-windowless-app#readme",
    "devDependencies": {
        "@eslint/compat": "2.1.1",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@tsconfig/node24": "24.0.5",
        "@types/jest": "30.0.0",
        "@types/node": "24.19.2",
        "@types/node-notifier": "8.0.5",
        "@types/validate-npm-package-name": "4.0.2",
        "@types/winston": "2.4.4",
        "@typescript-eslint/eslint-plugin": "8.71.1",
        "@typescript-eslint/parser": "8.71.1",
        "copy-webpack-plugin": "14.0.0",
        "cross-env": "10.1.0",
        "eslint": "10.13.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jest": "29.17.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-security": "4.2.0",
        "global-npm": "0.5.0",
        "globals": "17.13.0",
        "husky": "9.1.7",
        "jest": "30.5.2",
        "lint-staged": "17.6.0",
        "mocked-env": "1.3.5",
        "node-notifier": "10.0.1",
        "nyc": "18.0.0",
        "postject": "1.0.0-alpha.6",
        "prettier": "3.9.10",
        "rimraf": "6.1.3",
        "tmp-promise": "3.0.3",
        "ts-jest": "29.4.15",
        "ts-loader": "9.6.2",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "webpack": "5.112.0",
        "webpack-cli": "7.2.3",
        "winston": "3.19.0"
    },
    "dependencies": {
        "chalk": "4.1.2",
        "enquirer": "2.4.1",
        "validate-npm-package-name": "8.0.0"
    },
    "overrides": {
        "uuid": "11.1.1",
        "brace-expansion": "5.0.12",
        "minimatch@^3": {
            "brace-expansion": "1.1.21"
        },
        "minimatch@^9": {
            "brace-expansion": "2.1.7"
        }
    },
    "lint-staged": {
        "*.(ts|js)": [
            "eslint --fix"
        ],
        "*.json": [
            "prettier --write"
        ]
    }
}
