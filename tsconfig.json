{
    "extends": "@tsconfig/node20",
    "compilerOptions": {
        "strict": false,
        "esModuleInterop": true,
        "allowJs": true,
        "target": "es6",
        "noEmit": true,
        "verbatimModuleSyntax": false,
        "types": ["node", "jest"]
    },
    "include": ["./src/**/*", "./test/**/*", "./integration_test/**/*", "./templates/**/*", "jest.config.ts"]
}
